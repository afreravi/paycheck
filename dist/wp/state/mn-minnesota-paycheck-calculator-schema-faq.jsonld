{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Minnesota have a state income tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Minnesota taxes wage income on a graduated scale under Minnesota Statutes 290.06, subdivision 2c, with rates of 5.35%, 6.8%, 7.85%, and 9.85%. The 9.85% rate applies to the portion of taxable income above $161,720 for an unmarried filer and above $269,010 for a married couple filing jointly."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Minnesota standard deduction for 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Minnesota Statutes 290.0123 sets the standard deduction, and the 2026 data used here applies $14,575 for a single filer and $29,150 for a married couple filing jointly, with a separate head-of-household figure in between. The married-filing-separately amount is one-half of the married-joint amount. Subdivision 5 phases the deduction down as income rises, so high earners do not receive the full allowance."
      }
    },
    {
      "@type": "Question",
      "name": "Does Minnesota have a Paid Leave payroll deduction?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, beginning with wages paid in 2026. Minnesota Statutes 268B.14, subdivision 6 sets the 2026 employer premium rate at 0.7% for an employer offering both the family and medical benefit programs, and subdivision 3 requires the employer to pay at least half of the total premium. The employee pays the remaining share through a wage deduction, and subdivision 4 caps the wages subject to the premium at the Social Security wage base."
      }
    },
    {
      "@type": "Question",
      "name": "Do Minnesota cities or counties charge a local income tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Minnesota municipalities and counties do not levy an income tax on wages. Local revenue in Minnesota comes from property taxes, local sales taxes such as the one Duluth and the Twin Cities metro area collect, and fees, none of which are withheld from a paycheck."
      }
    },
    {
      "@type": "Question",
      "name": "How much is taken out of a $76,000 salary in Minnesota?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For 2026, a single filer paid biweekly takes home about $2,229.43 per paycheck from a $76,000 salary: $2,923.08 gross, $303.46 federal income tax, $181.23 Social Security, $42.38 Medicare, and $166.57 Minnesota state income tax. That is about $57,965.20 a year. The Paid Leave premium comes out on top of that figure."
      }
    },
    {
      "@type": "Question",
      "name": "Does Minnesota tax Social Security benefits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Minnesota starts its income tax from federal taxable income, so benefits that are taxable at the federal level are part of the Minnesota starting figure. Minnesota does offer a subtraction for some taxpayers who receive Social Security benefits, but it is limited by income and filing status and is claimed on the annual return rather than through paycheck withholding."
      }
    },
    {
      "@type": "Question",
      "name": "Is Minnesota's 9.85% rate charged on my whole salary?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Minnesota uses graduated brackets, so 9.85% applies only to the dollars of taxable income above $161,720 for an unmarried filer, above $214,980 for a head of household, and above $269,010 for a married couple filing jointly. A $76,000 salary is taxed at the lower rates on every dollar, which is why the effective state rate on that salary is far below 9.85%."
      }
    },
    {
      "@type": "Question",
      "name": "Do you have to file a Minnesota state tax return?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if you meet the filing thresholds. Minnesota requires a state return from residents whose income exceeds the threshold for their filing status, and Minnesota's thresholds are low enough that most wage earners with a regular job file. Minnesota also has a reciprocity agreement with Wisconsin, Michigan, and North Dakota that changes which state taxes certain income earned across the border."
      }
    }
  ]
}
