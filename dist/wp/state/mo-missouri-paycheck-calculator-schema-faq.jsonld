{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Missouri income tax rate for 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Missouri taxes wage income on a graduated schedule rather than at one flat rate. For 2026 the rates run 2%, 2.5%, 3%, 3.5%, 4%, 4.5%, and 4.7%, with the top 4.7% rate applying to Missouri taxable income above $9,436. Section 143.011 of the Missouri Revised Statutes sets the rates and requires the bracket thresholds to be adjusted for inflation every year."
      }
    },
    {
      "@type": "Question",
      "name": "Does Missouri tax capital gains?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Under section 143.121.3(14)(a), an individual may subtract 100% of any income reported as a capital gain for federal income tax purposes, for tax years beginning on or after January 1, 2025. The subtraction applies to Missouri adjusted gross income, so a Missouri resident pays no state income tax on a gain from selling stocks, funds, or real property. Interest and dividends are still taxed."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Missouri standard deduction for 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Missouri's standard deduction is $16,100 for a single filer or a married person filing separately, $32,200 for a married couple filing jointly, and $21,900 for a head of household. Missouri ties its standard deduction to the federal standard deduction instead of setting a fixed state amount, so the figure rises whenever the federal amount does."
      }
    },
    {
      "@type": "Question",
      "name": "How much is taken out of a $65,000 salary in Missouri?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For 2026, a single filer paid biweekly takes home about $2,035.45 per paycheck from a $65,000 salary: $2,500.00 gross, $216.15 federal income tax, $155.00 Social Security, $36.25 Medicare, and $57.15 Missouri state income tax. That is $52,921.60 a year, an effective tax rate of about 18.6%. A Kansas City or St. Louis earnings tax is not included."
      }
    },
    {
      "@type": "Question",
      "name": "Does Missouri have a local income tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Only in two cities. Kansas City and St. Louis each levy a 1% earnings tax on salaries, wages, and commissions, charged to residents on all their earnings and to nonresidents on what they earn in the city. Sections 92.111 to 92.200 of the Missouri Revised Statutes forbid any other city from imposing an earnings tax, so a Missouri worker outside those two cities pays no local income tax."
      }
    },
    {
      "@type": "Question",
      "name": "Can I deduct federal income tax on my Missouri return?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Section 143.171 lets an individual deduct a percentage of the federal income tax liability reported for the same year. The percentage is 35% at Missouri gross income of $25,000 or less, 25% from $25,001 to $50,000, 15% from $50,001 to $100,000, and 5% from $100,001 to $125,000, and it drops to zero at $125,001 and above. The deduction is capped at $5,000 on a single return and $10,000 on a combined return."
      }
    },
    {
      "@type": "Question",
      "name": "Does Missouri have disability or paid family leave withholding?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Missouri operates no state disability insurance program and no state paid family leave program, so neither an SDI nor a PFL deduction appears on a Missouri paycheck. The only state withholding is the graduated income tax, plus the 1% city earnings tax for workers in Kansas City and St. Louis."
      }
    },
    {
      "@type": "Question",
      "name": "Do Missouri's tax brackets change every year?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Section 143.011.5 requires the bracket thresholds to be adjusted annually for inflation, and the Department of Revenue publishes the new brackets each year beginning on or after October 1. The top rate can also fall: subsection 3 allows a 0.15 percentage point cut in any year that net general revenue exceeds the highest of the prior three years by at least $175 million, and subsection 4 allows up to three further cuts of 0.1 point each on a stricter revenue test."
      }
    }
  ]
}
