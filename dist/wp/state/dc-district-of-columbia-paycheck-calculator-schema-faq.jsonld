{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does the District of Columbia have an income tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. D.C. Code § 47-1806.03(a)(11) taxes individual income in seven bands: 4% up to $10,000 of taxable income, 6% to $40,000, 6.5% to $60,000, 8.5% to $250,000, 9.25% to $500,000, 9.75% to $1 million, and 10.75% above $1 million. The Office of Tax and Revenue publishes the same schedule."
      }
    },
    {
      "@type": "Question",
      "name": "How much is taken out of a $95,000 salary in the District of Columbia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For 2026, a single filer paid biweekly takes home about $2,713.69 per paycheck from a $95,000 salary: $3,653.85 gross, $464.23 federal income tax, $226.54 Social Security, $52.98 Medicare, and $196.40 DC income tax. That is $70,556.00 a year, an effective rate of about 25.7%."
      }
    },
    {
      "@type": "Question",
      "name": "What is the top DC income tax rate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "10.75%, charged on taxable income above $1 million. Below that the top bands are 9.75% from $500,000 to $1 million and 9.25% from $250,000 to $500,000. The 8.5% rate that most middle and upper-middle earners meet starts at $60,000 of taxable income for every filing status."
      }
    },
    {
      "@type": "Question",
      "name": "Does DC withhold disability insurance or paid family leave from a paycheck?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The District has no disability insurance payroll tax, and its Universal Paid Leave program is financed by a 0.75% contribution from covered employers under D.C. Code § 32-541.03, not by withholding from employees. This calculator subtracts no SDI and no paid leave premium, because a DC employee owes neither."
      }
    },
    {
      "@type": "Question",
      "name": "Do DC's tax brackets double for a married couple?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The District applies one rate table to a joint return's combined taxable income, so the $60,000 step into the 8.5% band falls at the same dollar amount for a couple as for a single filer. Two spouses living together who file separate returns are each treated as a single person under § 47-1806.03(e)."
      }
    },
    {
      "@type": "Question",
      "name": "What standard deduction does the District allow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under § 47-1801.04 the basic standard deduction for 2025 is $15,000 for a single filer or a married person filing separately, $22,500 for a head of household, and $30,000 for a married couple filing jointly, with a cost-of-living adjustment for tax years beginning after 2025. The 2026 data used here applies $16,100 for a single filer, so this page's DC line runs slightly below a return claiming the statutory deduction."
      }
    },
    {
      "@type": "Question",
      "name": "What form does a DC employee file for withholding?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Form D-4, the Employee's District of Columbia Withholding Allowance Certificate, which the employee gives to the employer rather than to the Office of Tax and Revenue. A nonresident claiming exemption from DC withholding on wages files Form D-4A instead. Both are separate from the federal Form W-4."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a county or city income tax on top of the DC rate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The District government is the only local jurisdiction between the federal government and a DC address, so there is no county, city, or school-district income tax to add. Neighbouring Maryland and Virginia residents do face a local layer, which is one reason a DC stub and a suburban stub differ even at the same state rate."
      }
    }
  ]
}
