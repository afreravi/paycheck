{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Arkansas have a state income tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Arkansas taxes wage income on a graduated scale set by Arkansas Code section 26-51-202 and imposed by section 26-51-201. The 2026 schedule used here charges 2% on the lowest band, 2.95% in the middle, and a top rate of 3.9% on taxable income above $100,000 for a single filer, so the state tax on a typical paycheck is small."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Arkansas income tax rate for 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The top marginal rate applied here for 2026 is 3.9%, reached once a single filer's taxable income passes $100,000. The lower bands are 2% and 2.95%. Arkansas reduced its top individual rate over the last decade and now ranks among the lower-tax states; the 2026 figures in this calculator reflect the schedule used in this repo."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Arkansas standard deduction for 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The 2026 data used here applies $2,340 for a single filer or a married person filing separately, $4,680 for a married couple filing jointly, and $3,510 for a head of household. Arkansas Code section 26-51-4301 sets the allowance, and a lower-income filer can also use the low-income tax tables under section 26-51-440 to reduce or eliminate the tax."
      }
    },
    {
      "@type": "Question",
      "name": "Do Arkansas cities or counties charge a local income tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. No city or county in Arkansas levies an income tax on wages, so nothing is withheld for Little Rock, Fayetteville, Fort Smith, or any other locality. Local revenue in Arkansas comes from sales and property taxes, neither of which is taken out of a paycheck."
      }
    },
    {
      "@type": "Question",
      "name": "Does Arkansas have state disability insurance or paid family leave?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Arkansas operates no state disability insurance program and withholds no payroll-funded family or medical leave premium, so there is no SDI or paid-leave line on an Arkansas paycheck. The graduated income tax is the only state deduction."
      }
    },
    {
      "@type": "Question",
      "name": "How much is taken out of a $60,000 salary in Arkansas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For 2026, a single filer paid biweekly takes home about $1,878.14 per paycheck from a $60,000 salary: $2,307.69 gross, $193.08 federal income tax, $143.08 Social Security, $33.46 Medicare, and $59.94 Arkansas state income tax. That is roughly $48,831.53 a year, an effective tax rate of about 18.6%."
      }
    },
    {
      "@type": "Question",
      "name": "Do you have to file an Arkansas state tax return?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if you meet Arkansas's filing thresholds. Arkansas requires a state individual income tax return from residents whose gross income exceeds the threshold for their filing status, and most wage earners with a regular job file. The return is where the low-income tax table and the personal credit are applied, so it can reduce the tax shown on a pay stub."
      }
    },
    {
      "@type": "Question",
      "name": "Why are Texarkana residents exempt from Arkansas income tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Arkansas grants a border city exemption to residents whose permanent residence is inside Texarkana, Arkansas, because the city straddles the Texas line and Texas has no income tax. Their income is exempt from Arkansas individual income tax, but they still file an Arkansas return to document the exemption, and it does not apply to a Texarkana resident working for an employer outside the city."
      }
    }
  ]
}
